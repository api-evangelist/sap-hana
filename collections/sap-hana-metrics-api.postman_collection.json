{
  "item": [
    {
      "id": "a105f34c-4238-43ba-80be-727445f9b2a8",
      "name": "Metrics",
      "description": {
        "content": "Operations for retrieving database performance metrics and resource utilization data for SAP HANA Cloud instances.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "670bd5a0-4498-400c-a4d9-128ded4724c5",
          "name": "Retrieve Metric Values for a Service Instance",
          "request": {
            "name": "Retrieve Metric Values for a Service Instance",
            "description": {
              "content": "Retrieves database performance and resource utilization metrics for a specific SAP HANA Cloud service instance. Metrics include CPU usage, memory consumption, disk utilization, connection counts, statement execution statistics, and other operational indicators. Data can be queried for specific time ranges and metric types.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metrics",
                "v1",
                "serviceInstances",
                ":serviceInstanceId",
                "values"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metricType",
                  "value": "<string>",
                  "description": "Filter metrics by type. Specify one or more metric types to retrieve specific categories of performance data."
                },
                {
                  "disabled": false,
                  "key": "fromTimestamp",
                  "value": "<dateTime>",
                  "description": "Start timestamp for the metrics query window in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "toTimestamp",
                  "value": "<dateTime>",
                  "description": "End timestamp for the metrics query window in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "<string>",
                  "description": "The aggregation granularity for metric data points. Determines the time interval between data points in the response."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "serviceInstanceId",
                  "description": "(Required) The unique identifier of the SAP HANA Cloud service instance for which to retrieve alerts, metrics, or metering data."
                },
                {
                  "description": "SAP BTP region identifier. Common values include eu10 (Europe - Frankfurt), us10 (US East - VA), ap10 (Australia - Sydney), jp10 (Japan - Tokyo), and others based on your SAP BTP subaccount provisioning. (This can only be one of eu10,eu11,eu20,eu30,us10,us20,us21,us30,ap10,ap11,ap12,ap20,ap21,jp10,jp20,br10,ca10,in30)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
