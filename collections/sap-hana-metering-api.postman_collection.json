    {
      "id": "d8972f2e-0810-425f-a955-bf0e6d5d3916",
      "name": "Metering",
      "description": {
        "content": "Operations for accessing consumption metering data used for billing and capacity planning for SAP HANA Cloud instances.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1d25fb0a-2cd4-4d5e-9692-d2b48440a69a",
          "name": "Retrieve Metering Data for a Service Instance",
          "request": {
            "name": "Retrieve Metering Data for a Service Instance",
            "description": {
              "content": "Retrieves consumption metering data for a specific SAP HANA Cloud service instance. Metering data includes compute unit hours, storage consumption, data lake capacity utilization, and other billable metrics used for cost tracking and capacity planning.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metering",
                "v1",
                "serviceInstances",
                ":serviceInstanceId",
                "values"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fromTimestamp",
                  "value": "<dateTime>",
                  "description": "Start timestamp for the metering data query window in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "toTimestamp",
                  "value": "<dateTime>",
                  "description": "End timestamp for the metering data query window in ISO 8601 format."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "serviceInstanceId",
                  "description": "(Required) The unique identifier of the SAP HANA Cloud service instance for which to retrieve alerts, metrics, or metering data."
                },
                {
                  "description": "SAP BTP region identifier. Common values include eu10 (Europe - Frankfurt), us10 (US East - VA), ap10 (Australia - Sydney), jp10 (Japan - Tokyo), and others based on your SAP BTP subaccount provisioning. (This can only be one of eu10,eu11,eu20,eu30,us10,us20,us21,us30,ap10,ap11,ap12,ap20,ap21,jp10,jp20,br10,ca10,in30)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
