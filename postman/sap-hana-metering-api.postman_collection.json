                                  "id": "48a3fe18-4001-4e49-9b1d-24680b474a0e",
                                  "key": "serviceInstanceId",
                                  "value": "<uuid>",
                                  "description": "(Required) The unique identifier of the SAP HANA Cloud service instance for which to retrieve alerts, metrics, or metering data."
                                }
                              ]
                            },
                            "description": "Retrieves consumption metering data for a specific SAP HANA Cloud service instance. Metering data includes compute unit hours, storage consumption, data lake capacity utilization, and other billable metrics used for cost tracking and capacity planning."
