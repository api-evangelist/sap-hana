                          "name": "Retrieve Metric Values for a Service Instance",
                          "id": "443e1bf0-86c3-45de-9c17-43a9e26cc0c2",
                          "protocolProfileBehavior": {
                            "disableBodyPruning": true
                          },
                          "request": {
