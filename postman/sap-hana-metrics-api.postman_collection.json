                                "key": "Accept",
                                "value": "application/json"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/metrics/v1/serviceInstances/:serviceInstanceId/values?metricType=memory&fromTimestamp=<dateTime>&toTimestamp=<dateTime>&granularity=HOUR",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "metrics",
                                "v1",
                                "serviceInstances",
                                ":serviceInstanceId",
                                "values"
                              ],
                              "query": [
                                {
                                  "description": "Filter metrics by type. Specify one or more metric types to retrieve specific categories of performance data.",
                                  "key": "metricType",
                                  "value": "memory"
                                },
                                {
                                  "description": "Start timestamp for the metrics query window in ISO 8601 format.",
                                  "key": "fromTimestamp",
                                  "value": "<dateTime>"
                                },
                                {
